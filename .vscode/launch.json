{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Music: Local preview stream sender",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.runner",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json",
        "--rtmp-url",
        "udp://127.0.0.1:1234?pkt_size=1316",
        "--output-format",
        "mpegts"
      ],
      "justMyCode": true
    },
    {
      "name": "Music: Local preview viewer",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.local_viewer",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--url",
        "udp://@:1234?fifo_size=1000000&overrun_nonfatal=1"
      ],
      "justMyCode": true
    },
    {
      // The "direct" profile of config.json sends the radio straight to the destination (no MediaMTX).
      "name": "Music: Stream direct to destination",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.runner",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json",
        "--profile",
        "direct"
      ],
      "justMyCode": true
    },
    {
      "name": "Backend: Control API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start_control_api.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "INSTANCE_API_KEY": "change-me-shared-secret",
        "DJANGO_SECRET_KEY": "debug-secret-key",
        "DJANGO_DEBUG": "1"
      },
      // Opens the show controls once runserver_plus is up (self-signed certificate: the browser warns once).
      "serverReadyAction": {
        "pattern": "Running on (https://[^\\s]+)",
        "uriFormat": "%s/show/",
        "action": "openExternally"
      },
      "justMyCode": true
    },
    {
      "name": "Music: Radio to MediaMTX",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.runner",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json",
        "--rtmp-url",
        "rtmp://127.0.0.1:1935/radio"
      ],
      "justMyCode": true
    },
    {
      // Sends OBS (path /laptop) when it streams, otherwise the radio, to output_url.
      "name": "Switcher: OBS or radio to destination",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.switcher",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json"
      ],
      "postDebugTask": "MediaMTX: stop",
      "justMyCode": true
    },
    {
      // What the switcher sends, read back from MediaMTX over RTMP. (ffplay reads MediaMTX's
      // low-latency HLS in 2 s bursts, which looks like constant freezing.)
      "name": "Preview: switcher output",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.local_viewer",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--url",
        "rtmp://127.0.0.1:1935/live"
      ],
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      // The control API edits config.json, which the sender reloads while streaming:
      // https://127.0.0.1:8443/show/ (secret: INSTANCE_API_KEY of "Backend: Control API").
      "name": "Tier 2: Local preview stream + viewer + control API",
      "configurations": [
        "Music: Local preview stream sender",
        "Music: Local preview viewer",
        "Backend: Control API"
      ],
      "stopAll": true
    },
    {
      "name": "Tier 3: Stream + backend API",
      "configurations": [
        "Music: Stream direct to destination",
        "Backend: Control API"
      ],
      "stopAll": true
    },
    {
      // MediaMTX runs as a task (terminal panel) and is stopped with the switcher.
      // Point OBS at rtmp://127.0.0.1:1935 with the stream key laptop?user=laptop_streamer&pass=...
      "name": "Tier 4: Stream with MediaMTX OBS switch",
      "preLaunchTask": "MediaMTX: start",
      "configurations": [
        "Music: Radio to MediaMTX",
        "Switcher: OBS or radio to destination",
        "Preview: switcher output"
      ],
      "stopAll": true
    }
  ]
}
