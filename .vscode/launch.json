{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Music: Local random playback",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.local_playback",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json"
      ],
      "justMyCode": true
    },
    {
      "name": "Music: VPS non-audible self-test",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.self_test",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json"
      ],
      "justMyCode": true
    },
    {
      "name": "Music: VPS self-test (skip RTMP)",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.self_test",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json",
        "--rtmp-url",
        ""
      ],
      "justMyCode": true
    },
    {
      "name": "Music: Local preview stream sender",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.runner",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json",
        "--rtmp-url",
        "udp://127.0.0.1:1234?pkt_size=1316",
        "--output-format",
        "mpegts"
      ],
      "justMyCode": true
    },
    {
      "name": "Music: Local preview viewer",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.local_viewer",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--url",
        "udp://@:1234?fifo_size=1000000&overrun_nonfatal=1"
      ],
      "justMyCode": true
    },
    {
      "name": "Music: Full stream stack",
      "type": "debugpy",
      "request": "launch",
      "module": "livestream.runner",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--config",
        "${workspaceFolder}/config.json"
      ],
      "justMyCode": true
    },
    {
      "name": "Backend: Control API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start_control_api.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "INSTANCE_API_KEY": "change-me-shared-secret",
        "DJANGO_SECRET_KEY": "debug-secret-key",
        "DJANGO_DEBUG": "1"
      },
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Tier 0: VPS self-test",
      "configurations": [
        "Music: VPS non-audible self-test"
      ]
    },
    {
      "name": "Tier 1: Local random playback",
      "configurations": [
        "Music: Local random playback"
      ]
    },
    {
      "name": "Tier 1.5: Validate + local playback",
      "configurations": [
        "Music: VPS non-audible self-test",
        "Music: Local random playback"
      ]
    },
    {
      "name": "Tier 2: Local preview stream + viewer",
      "configurations": [
        "Music: Local preview stream sender",
        "Music: Local preview viewer"
      ]
    },
    {
      "name": "Tier 3: Full stream + backend API",
      "configurations": [
        "Music: Full stream stack",
        "Backend: Control API"
      ]
    }
  ]
}
