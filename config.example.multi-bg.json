{
  "music_dir": "~/Dropbox/Music/",
  
  "background_videos": "submodules/obscustomsetup/assets/stream loop 1.mp4, submodules/obscustomsetup/assets/stream loop 2.mp4",
  
  "rtmp_url": "rtmp://your-ingest-server/live/YOUR_STREAM_KEY",
  
  "output_url": "rtmp://live.restream.io/live/YOUR_RESTREAM_KEY",
  
  "restream_client_id": "paste-the-client-id-here",
  "restream_client_secret": "paste-the-client-secret-here",
  
  "takeover_delay": 1.0,
  "release_timeout": 3.0,
  "restart_delay": 2.0,
  "track_fade_seconds": 3.0,
  
  "video_bitrate": "4500k",
  "video_fps": 30,
  "video_size": "1920x1080",
  "video_preset": "veryfast",
  "encoder_threads": 4,
  "rc_lookahead": 10,
  
  "background_size": "1280x720",
  "background_bitrate": "4M",
  
  "audio_bitrate": "320k",
  "keyframe_seconds": 2,
  
  "loudness_normalize": true,
  "loudness_target": -14,
  "loudness_max_gain": 9,
  
  "stall_timeout": 15,
  "network_timeout": 10,
  
  "cache_dir": "~/.cache/music-livestream",
  
  "menu_text": "45 to 33 rpm\nPopuri Music",
  "countdown_enabled": false,
  "countdown_hour": 19,
  "countdown_minute": 45,
  
  "profiles": {
    "preview": {
      "rtmp_url": "udp://127.0.0.1:1234?pkt_size=1316",
      "output_format": "mpegts",
      "video_bitrate": "2000k",
      "background_bitrate": "2M"
    },
    
    "high_quality": {
      "video_bitrate": "8000k",
      "audio_bitrate": "320k",
      "video_preset": "slow",
      "background_bitrate": "8M",
      "background_size": "1920x1080"
    },
    
    "low_bandwidth": {
      "video_bitrate": "2000k",
      "audio_bitrate": "128k",
      "video_preset": "ultrafast",
      "background_bitrate": "2M",
      "background_size": "960x540"
    }
  }
}
